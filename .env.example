# Storage backend: 'json' (default) or 'supabase'
STORAGE=json

# Supabase config (only needed when STORAGE=supabase)
SUPABASE_URL=
SUPABASE_KEY=

# Server port
PORT=3000

# Optional: allow cross-origin API access from these origins (comma-separated).
# Leave unset for same-origin only (the bundled frontend needs no CORS).
# Example: ALLOWED_ORIGIN=https://wwm-gvgroster.onrender.com
ALLOWED_ORIGIN=
